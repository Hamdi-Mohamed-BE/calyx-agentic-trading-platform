CALYX_WHATSAPP_DISPLAY=Contact via live site
CALYX_ENABLE_LIVE_MT5=false
EA_STORE_MT5_TERMINAL=
EA_STORE_TESTER_SERVER=
EA_STORE_TESTER_LOGIN=
